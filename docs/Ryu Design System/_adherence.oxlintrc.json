      {
        "selector": "JSXOpeningElement[name.name='InboxItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|title|body|time|read|children|style|key|ref|className|style|children)$/]",
        "message": "<InboxItem> doesn't accept that prop. Declared props: severity, title, body, time, read, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InboxItem'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:action_required|attention|info)$/]",
        "message": "<InboxItem> severity must be one of 'action_required' | 'attention' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|full|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: size, tone, full."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:raised|sunken)$/]",
        "message": "<Input> tone must be one of 'raised' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IssueCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:issueKey|title|priority|assignee|assigneeType|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IssueCard> doesn't accept that prop. Declared props: issueKey, title, priority, assignee, assigneeType, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IssueCard'] > JSXAttribute[name.name='priority'] > Literal[value!=/^(?:urgent|high|medium|low|none)$/]",
        "message": "<IssueCard> priority must be one of 'urgent' | 'high' | 'medium' | 'low' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IssueCard'] > JSXAttribute[name.name='assigneeType'] > Literal[value!=/^(?:agent|member)$/]",
        "message": "<IssueCard> assigneeType must be one of 'agent' | 'member'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IssueKey'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<IssueKey> doesn't accept that prop. Declared props: children, style."
