# Exemplo de variáveis de ambiente do Ryu (prefixo RYU_).
# Copie para ./ryu.env e descomente/ajuste o que precisar.
# O ryu-up.sh gerencia RYU_JWT_SECRET automaticamente em ~/.config/ryu/secret.

# =============================================================================
# CORE
# =============================================================================

# Obrigatório em produção; assina os tokens de sessão.
# O ryu-up.sh gera e persiste este valor sozinho.
# RYU_JWT_SECRET=change-me

# SQLite (padrão no container) ou Postgres.
# RYU_DATABASE_URL=sqlite+aiosqlite:////data/ryu.db
# RYU_DATABASE_URL=postgresql+asyncpg://user:pass@host/ryu

# Raiz de dados persistentes (o ryu-up.sh monta o volume em /data).
# RYU_DATA_DIR=/data
# RYU_WORKSPACES_ROOT=/data/workspaces
# RYU_UPLOADS_DIR=/data/uploads

# Cadastro de novos usuários e allowlists.
# RYU_ALLOW_SIGNUP=true
# RYU_ALLOWED_EMAILS=alice@exemplo.com,bob@exemplo.com
# RYU_ALLOWED_EMAIL_DOMAINS=exemplo.com
# RYU_DISABLE_WORKSPACE_CREATION=false
# RYU_INVITATION_TTL_DAYS=7

# Código fixo de login em modo dev (nunca use em produção).
# RYU_DEV_VERIFICATION_CODE=000000

# Porta HTTP interna do container e URL pública (convites, CLI).
# RYU_PORT=8000
# RYU_APP_URL=https://ryu.exemplo.com

# Modelo padrão do LiteLLM para títulos etc.
# RYU_LITELLM_MODEL=anthropic/claude-3-5-haiku-20241022

# Diretório varrido por /api/skills/local-runtime.
# RYU_LOCAL_SKILLS_DIR=/root/.claude/skills

# Diretório de config do CLI/daemon local (fora do container).
# RYU_CONFIG_DIR=/root/.ryu

# =============================================================================
# AUTH / SIGNUP
# =============================================================================

# Cooldown e rate limits (0 desliga).
# RYU_AUTH_CODE_RESEND_SECONDS=60
# RYU_RATE_LIMIT_AUTH=5
# RYU_RATE_LIMIT_AUTH_VERIFY=20

# Google OAuth (opcional).
# RYU_GOOGLE_CLIENT_ID=
# RYU_GOOGLE_CLIENT_SECRET=
# RYU_GOOGLE_REDIRECT_URI=https://ryu.exemplo.com/api/auth/google/callback

# =============================================================================
# E-MAIL
# =============================================================================

# Prioridade: SMTP > Resend > stdout dos logs do container.
# RYU_SMTP_HOST=smtp.exemplo.com
# RYU_SMTP_PORT=25
# RYU_SMTP_USERNAME=
# RYU_SMTP_PASSWORD=
# RYU_SMTP_FROM_EMAIL=ryu@exemplo.com
# RYU_SMTP_TLS=starttls
# RYU_SMTP_EHLO_NAME=

# RYU_RESEND_API_KEY=
# RYU_RESEND_FROM_EMAIL=ryu@exemplo.com

# =============================================================================
# LLM (títulos de chat etc.)
# =============================================================================

# RYU_ANTHROPIC_API_KEY=
# RYU_OPENAI_API_KEY=
# RYU_OPENAI_BASE_URL=https://api.openai.com/v1
# RYU_LLM_TIMEOUT_SECONDS=15.0

# =============================================================================
# ATTACHMENTS / S3
# =============================================================================

# auto = usa S3 se s3_bucket + credenciais estiverem configurados.
# RYU_ATTACHMENT_STORAGE=auto
# RYU_ATTACHMENT_MAX_SIZE_BYTES=104857600
# RYU_ATTACHMENT_DOWNLOAD_URL_TTL=1800

# RYU_S3_BUCKET=
# RYU_S3_REGION=us-east-1
# RYU_S3_ENDPOINT=https://s3.compat-provider.com
# RYU_S3_ACCESS_KEY_ID=
# RYU_S3_SECRET_ACCESS_KEY=
# RYU_S3_PUBLIC_BASE_URL=https://cdn.exemplo.com

# =============================================================================
# RUNNER / TASKS
# =============================================================================

# RYU_RUNNER_MAX_PARALLEL=8
# RYU_TASK_LEASE_MINUTES=30
# RYU_TASK_HEARTBEAT_SECONDS=20
# RYU_TASK_RUN_TIMEOUT_MINUTES=30
# RYU_TASK_QUEUED_TTL_HOURS=24
# RYU_TASK_DEFAULT_MAX_ATTEMPTS=3
# RYU_SWEEP_INTERVAL_SECONDS=60
# RYU_WORKDIR_GC_DAYS=7
# RYU_WORKDIR_GC_INTERVAL_SECONDS=3600

# Limite de pins da barra de quick-agents no chat.
# RYU_CHAT_PINNED_AGENTS_CAP=8

# =============================================================================
# AUTOPILOTS / WEBHOOKS
# =============================================================================

# RYU_WEBHOOK_BODY_MAX_BYTES=262144
# RYU_WEBHOOK_PAYLOAD_PROMPT_MAX_CHARS=8000

# =============================================================================
# DAEMON / CLI
# =============================================================================

# Configuração usada pelo CLI/daemon (fora do container).
# RYU_URL=http://localhost:8000
# RYU_APP_URL=https://ryu.exemplo.com
# RYU_TOKEN=
# RYU_WORKSPACE_ID=
# RYU_PROFILE=

# RYU_DAEMON_POLL_INTERVAL=3
# RYU_DAEMON_HEARTBEAT_INTERVAL=15
# RYU_DAEMON_MAX_CONCURRENT_TASKS=4
# RYU_DAEMON_ID=desktop
# RYU_DAEMON_DEVICE_NAME=desktop
# RYU_DAEMON_WORKSPACES_ROOT=/root/.ryu/workspaces

# Overrides dos binários/models/argumentos dos agentes.
# Exemplos: RYU_CLAUDE_PATH, RYU_CODEX_MODEL, RYU_GEMINI_ARGS
# RYU_CLAUDE_PATH=
# RYU_CODEX_PATH=
# RYU_GEMINI_PATH=
# RYU_OPENCODE_PATH=
# RYU_COPILOT_PATH=
# RYU_CURSOR_PATH=
# RYU_QWEN_PATH=

# Lista de modelos oferecidos por provider no daemon.
# RYU_CLAUDE_MODELS=opus,sonnet,haiku
# RYU_CODEX_MODELS=gpt-5-codex,o4-mini,o3

# =============================================================================
# USAGE / OBSERVABILITY
# =============================================================================

# RYU_METRICS_ENABLED=true
# RYU_USAGE_ROLLUP_INTERVAL_SECONDS=60
# RYU_READINESS_CACHE_SECONDS=5.0

# =============================================================================
# GITHUB
# =============================================================================

# GitHub App (instalação e webhooks).
# RYU_GITHUB_APP_ID=
# RYU_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# RYU_GITHUB_APP_CLIENT_ID=
# RYU_GITHUB_APP_CLIENT_SECRET=
# RYU_GITHUB_APP_SLUG=
# RYU_GITHUB_WEBHOOK_SECRET=
# RYU_GITHUB_API_BASE_URL=https://api.github.com

# Cache de snapshot para VCS self-hosted.
# RYU_VCS_CHECK_SNAPSHOT_TTL_SECONDS=300

# =============================================================================
# SLACK & LARK
# =============================================================================

# Ativa/desativa globalmente os canais (tokens ficam no banco por workspace).
# RYU_SLACK_ENABLED=true
# RYU_SLACK_API_BASE_URL=https://slack.com/api
# RYU_LARK_ENABLED=true

# =============================================================================
# INTEGRATIONS
# =============================================================================

# Chave para criptografar tokens/secrets de integrações no banco.
# Se omitida, faz fallback para RYU_JWT_SECRET.
# RYU_INTEGRATIONS_SECRET_KEY=
